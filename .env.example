# Entorno
NODE_ENV=development
PORT=3000

# Agente de IA — webhook del flujo en n8n
# Es la URL que el frontend llama para conversar con el agente.
# La de producción termina en /webhook/; la de pruebas, en /webhook-test/
# y solo responde con el editor de n8n escuchando.
N8N_WEBHOOK_URL=

# Supabase — autenticación y registro de uso
# URL y anon key: Project Settings > API
# Service role key: Project Settings > API (secreta, nunca debe salir del backend)
# Ojo: SUPABASE_URL es solo el origen del proyecto (https://xxxxx.supabase.co),
# SIN /rest/v1 ni ninguna otra ruta: el SDK añade la suya.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Tabla donde se guarda el registro de peticiones (ver docs/supabase-setup.sql)
SUPABASE_TABLA_AUDITORIA=registro_uso

# APIs Corporativas - Ripley (una URL base por país)
RIPLEY_API_URL_PE=
RIPLEY_API_URL_CL=

# Los tokens corporativos YA NO van aquí: cada usuario guarda el suyo desde el
# panel y se almacena cifrado en Supabase (tabla ripley_tokens).
#
# Clave con la que se cifran esos tokens. Mínimo 32 caracteres.
# Generar una con:  openssl rand -base64 48
# Si se cambia, los tokens ya guardados dejan de poder descifrarse y cada
# usuario tendrá que volver a ingresarlo.
TOKENS_CLAVE_CIFRADO=

# Prefijo común que antecede a todas las rutas de RIPLEY_EP_* (puede ir vacío)
RIPLEY_PATH_PREFIX=

# Endpoints compartidos entre features (relativos al prefijo)
RIPLEY_EP_CAPACITIES_PICKING=
RIPLEY_EP_SCHEDULES_PICKING=
RIPLEY_EP_SERVICES=
RIPLEY_EP_OFFICES=

# Endpoints de despacho
RIPLEY_EP_MAINZONES=
RIPLEY_EP_MAINSCHEDULES=
RIPLEY_EP_CAPACITIES_BASE=
RIPLEY_EP_CAPACITIES_SCHEDULE=

# Configuración masiva de tipos de servicio
RIPLEY_EP_DELIVERY=
RIPLEY_EP_CATALOGS=
RIPLEY_EP_ROUTES_STATE=
RIPLEY_EP_ROUTES_UPDATE=

# Configuración de tipos de servicio por OPL
RIPLEY_EP_LIST_TYPE_SERVICES=
RIPLEY_EP_SAVE_OPL_SERVICE=

# Transferencia entre sucursales
RIPLEY_EP_OFFICE_RELATIONSHIP=

# Simulación
RIPLEY_EP_REGIONS=
RIPLEY_EP_SKU=
RIPLEY_EP_SIMULATOR=
