# Entorno
# No lo lee este backend: lo leen Node y las dependencias
NODE_ENV=
PORT=

# Agente de IA — webhook del flujo en n8n
# La de producción termina en /webhook/; la de pruebas, en /webhook-test/
# y solo responde con el editor de n8n escuchando.
N8N_WEBHOOK_URL=
# API de n8n, para que "Detener" pare la ejecución en curso. Opcional.
# N8N_API_URL es solo el origen (https://tu-n8n.com), sin /api/v1.
# La clave se crea en n8n: Settings → n8n API. Nunca sale del backend.
N8N_API_URL=
N8N_API_KEY=

# Supabase — autenticación y registro de uso
# SUPABASE_URL es solo el origen (https://xxxxx.supabase.co), sin /rest/v1.
SUPABASE_URL=
# Pública: solo para el login
SUPABASE_ANON_KEY=
# Privada: nunca sale del backend
SUPABASE_SERVICE_ROLE_KEY=
# Ver docs/supabase-setup.sql
SUPABASE_TABLA_AUDITORIA=

# Clave con la que se cifran los tokens corporativos. Mínimo 32 caracteres.
# Si se cambia, los tokens ya guardados dejan de poder descifrarse.
TOKENS_CLAVE_CIFRADO=

# APIs corporativas de Ripley — una URL base por país
RIPLEY_API_URL_PE=
RIPLEY_API_URL_CL=

# Prefijo común que antecede a todas las rutas de RIPLEY_EP_* (puede ir vacío)
RIPLEY_PATH_PREFIX=

# Endpoints compartidos entre features (relativos al prefijo)
RIPLEY_EP_OFFICES=
RIPLEY_EP_SERVICES=

# Picking
RIPLEY_EP_SCHEDULES_PICKING=
RIPLEY_EP_CAPACITIES_PICKING=

# Recepción
# Ojo: el de capacidades va SIN sufijo —el id se pega detrás— a diferencia
# de /capacities/picking y /capacities/schedule.
RIPLEY_EP_SCHEDULES_RECEPTION=
RIPLEY_EP_CAPACITIES_RECEPTION=

# Despacho
RIPLEY_EP_MAINZONES=
RIPLEY_EP_MAINSCHEDULES=
RIPLEY_EP_CAPACITIES_BASE=
RIPLEY_EP_CAPACITIES_SCHEDULE=

# Activación masiva de tipos de servicio
RIPLEY_EP_DELIVERY=
RIPLEY_EP_CATALOGS=
RIPLEY_EP_ROUTES_STATE=
RIPLEY_EP_ROUTES_UPDATE=

# Tipos de servicio por OPL
RIPLEY_EP_LIST_TYPE_SERVICES=
RIPLEY_EP_SAVE_OPL_SERVICE=

# Transferencia entre sucursales
RIPLEY_EP_OFFICE_RELATIONSHIP=

# Simulación de entregas
RIPLEY_EP_REGIONS=
RIPLEY_EP_SKU=
RIPLEY_EP_SIMULATOR=
